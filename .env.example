# Copier ce fichier vers .env puis renseigner les clés réelles.
# .env est ignoré par git : ne jamais committer une clé.
# Ce fichier-ci (.env.example) est versionné : il ne doit contenir que des placeholders.

# Groq — https://console.groq.com/keys  (préfixe gsk_)
GROQ_API_KEY=gsk_votre_cle_groq

# Tavily — https://app.tavily.com/home  (préfixe tvly-, optionnel :
# sans cette clé l'outil web devient un stub « désactivé »)
TAVILY_API_KEY=tvly-votre_cle_tavily
